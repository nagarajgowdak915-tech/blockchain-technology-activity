import hashlib
import json
import time


# Block Class
class Block:
    def __init__(self, index, timestamp, shipment_data, previous_hash):
        self.index = index
        self.timestamp = timestamp
        self.shipment_data = shipment_data
        self.previous_hash = previous_hash
        self.hash = self.calculate_hash()

    def calculate_hash(self):
        block_data = {
            "index": self.index,
            "timestamp": self.timestamp,
            "shipment_data": self.shipment_data,
            "previous_hash": self.previous_hash
        }

        encoded_data = json.dumps(
            block_data, sort_keys=True
        ).encode()

        return hashlib.sha256(encoded_data).hexdigest()


# Shipment Blockchain Class
class ShipmentBlockchain:
    def __init__(self):
        self.chain = [self.create_genesis_block()]

    def create_genesis_block(self):
        return Block(
            0,
            time.time(),
            {"status": "Genesis Block Created"},
            "0"
        )

    def get_latest_block(self):
        return self.chain[-1]

    def add_shipment(self, shipment_data):
        previous_block = self.get_latest_block()

        new_block = Block(
            len(self.chain),
            time.time(),
            shipment_data,
            previous_block.hash
        )

        self.chain.append(new_block)

    def display_chain(self):
        print("\n===== SHIPMENT TRACKING SYSTEM =====")

        for block in self.chain:
            print("\nBlock Number:", block.index)
            print("Timestamp:", block.timestamp)
            print("Shipment Data:", block.shipment_data)
            print("Previous Hash:", block.previous_hash)
            print("Current Hash:", block.hash)

    def is_chain_valid(self):
        for i in range(1, len(self.chain)):
            current_block = self.chain[i]
            previous_block = self.chain[i - 1]

            if current_block.hash != current_block.calculate_hash():
                return False

            if current_block.previous_hash != previous_block.hash:
                return False

        return True


# Main Program
shipment_chain = ShipmentBlockchain()

shipment_chain.add_shipment({
    "shipment_id": "SHIP101",
